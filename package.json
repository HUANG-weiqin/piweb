{
  "name": "piweb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "predev": "npm run context-compressor:build",
    "dev": "concurrently -k \"vite\" \"node --import tsx/esm --watch src/server/index.ts\"",
    "prebuild": "npm run context-compressor:build",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "pretypecheck": "npm run context-compressor:build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && npm run context-compressor:typecheck",
    "pretest": "npm run context-compressor:build",
    "test": "vitest run --exclude \".worktrees/**\"",
    "context-compressor:build": "npm run build --workspace=@piweb/context-compressor",
    "context-compressor:test": "vitest run packages/context-compressor/test/index.test.ts",
    "context-compressor:typecheck": "tsc -p packages/context-compressor/tsconfig.test.json",
    "context-compressor:benchmark": "npm run context-compressor:build && tsx scripts/benchmark-context-compressor.ts"
  },
  "dependencies": {
    "@piweb/context-compressor": "workspace:*",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "dompurify": "^3.2.6",
    "express": "^5.1.0",
    "marked": "^15.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typebox": "^1.1.38",
    "ws": "^8.18.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
